{
  "manifest_version": 3,
  "name": "Team Vault Demo",
  "version": "1.0.1",
  "description": "Encrypted team vault with user-selected autofill.",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": ["http://localhost:8082/*"],
  "content_scripts": [{ "matches": ["https://*/*", "http://localhost/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Team Vault" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" } } }
}
